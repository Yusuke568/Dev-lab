<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">

    <display-name>Kintai Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>com.example.shared.web.FrontController</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size> <!-- 10MB -->
            <max-request-size>104857600</max-request-size> <!-- 100MB（作業報告書をまとめて取り込むため） -->
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <!--
        思わぬエラーのときも Tomcat の標準のエラー画面（例外の中身やスタックトレースが出る）を出さず、
        アプリのエラー画面を出す。詳しい内容はサーバーのログ（catalina.out）に残る。
    -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/view/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/view/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/view/error.jsp</location>
    </error-page>

</web-app>